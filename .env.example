# ---------------------------------------------------------------------------
# 複製為 .env 後填入真實值：cp .env.example .env
# .env 已被 .gitignore 忽略，請勿提交
# ---------------------------------------------------------------------------

# ---- 對外服務 ----
# 前端對外網址（QR Code 會以此組出 /q/{token} 連結）
PUBLIC_BASE_URL=http://localhost:8080
WEB_PORT=8080
TZ=Asia/Taipei

# ---- PostgreSQL ----
POSTGRES_DB=queue
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME__strong_postgres_password

# ---- JWT ----
# 至少 32 字元，長度不足會拒絕啟動（見 OptionGuard.EnsureJwtSecret）
# 產生方式：openssl rand -base64 48
JWT_SECRET=CHANGE_ME__jwt_signing_secret_at_least_32_chars
JWT_ISSUER=QueueManagement
JWT_AUDIENCE=QueueWeb
JWT_EXPIRE_MINUTES=480

# ---- QR Token ----
# 產生方式：openssl rand -base64 48
QR_SIGNING_KEY=CHANGE_ME__qr_signing_key_at_least_32_chars
QR_TOKEN_LIFETIME_HOURS=72

# ---- 排隊規則（§17 / §18）----
QUEUE_DEFAULT_SERVICE_MINUTES=5
QUEUE_AGING_ENABLED=false
QUEUE_AGING_FACTOR_MINUTES=10
QUEUE_MAX_RECALL_COUNT=2

# ---- 選用 ----
REDIS_CONNECTION_STRING=
MIGRATE_ON_STARTUP=true
